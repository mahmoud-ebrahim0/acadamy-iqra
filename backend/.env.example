# Copy this file to `.env` and fill in the values. Never commit the real `.env`.

# --- Required ---------------------------------------------------------------
# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/quran_academy

# Random secret used to sign login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Address of the website (used for CORS and Stripe redirects)
FRONTEND_URL=http://localhost:5173

# --- Optional ---------------------------------------------------------------
# Extra allowed website origins, comma separated (e.g. a preview domain)
CORS_ORIGINS=

# Public address of this API, used to build links to locally stored uploads
PUBLIC_API_URL=http://localhost:5000

# Port for local development
PORT=5000

# Cloudinary (image uploads). Without it uploads are stored on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (card payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gmail account used to send free-consultation requests (use a Gmail "App Password")
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=
